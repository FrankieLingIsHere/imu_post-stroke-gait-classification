# One checked patch contract shared by Android and host regression builds.
function(gait_lens_replace old new)
  string(FIND "${content}" "${old}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Pinned OpenVINS lens patch no longer matches ${relative}")
  endif()
  string(REPLACE "${old}" "${new}" content "${content}")
  set(content "${content}" PARENT_SCOPE)
endfunction()
function(gait_patch_fixed_lens relative input output)
  set(content "${input}")
  if(relative STREQUAL "ov_core/src/cam/CamBase.h")
    gait_lens_replace("virtual ~CamBase() {}" "virtual ~CamBase() {}\n  virtual double fixed_radial_k3() const { return 0; }")
  elseif(relative STREQUAL "ov_init/src/ceres/Factor_ImageReprojCalib.h")
    gait_lens_replace("bool is_fisheye = false;" "bool is_fisheye = false;\n  double fixed_k3 = 0;")
    gait_lens_replace("bool is_fisheye_);" "bool is_fisheye_, double fixed_k3_ = 0);")
  elseif(relative STREQUAL "ov_init/src/ceres/Factor_ImageReprojCalib.cpp")
    gait_lens_replace("#include \"Factor_ImageReprojCalib.h\"" "#include \"Factor_ImageReprojCalib.h\"\n#include \"reference_radtan5.h\"")
    gait_lens_replace("double pix_sigma_, bool is_fisheye_)" "double pix_sigma_, bool is_fisheye_, double fixed_k3_)")
    gait_lens_replace("is_fisheye(is_fisheye_) {" "is_fisheye(is_fisheye_), fixed_k3(fixed_k3_) {")
    gait_lens_replace("ov_core::CamRadtan cam(0, 0);" "gait::ReferenceRadtan5 cam(0, 0, fixed_k3);")
  elseif(relative STREQUAL "ov_init/src/dynamic/DynamicInitializer.cpp")
    gait_lens_replace("new Factor_ImageReprojCalib(uv_raw, params.sigma_pix, is_fisheye)"
      "new Factor_ImageReprojCalib(uv_raw, params.sigma_pix, is_fisheye, params.camera_intrinsics.at(cam_id)->fixed_radial_k3())")
  endif()
  set(${output} "${content}" PARENT_SCOPE)
endfunction()
