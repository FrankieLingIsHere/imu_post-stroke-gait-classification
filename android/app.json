{
  "expo": {
    "name": "GaitTrace",
    "slug": "gait-steps",
    "version": "0.3.6",
    "icon": "./assets/branding/icon.png",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/3db4ae90-2d4d-41f9-9689-f70f656ac581",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gaitsteps.app"
    },
    "android": {
      "package": "com.gaitsteps.app",
      "versionCode": 15,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/icon.png",
        "backgroundColor": "#176B62"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "name": "GaitTrace",
      "shortName": "GaitTrace",
      "themeColor": "#176B62",
      "backgroundColor": "#F6F3EC"
    },
    "sdkVersion": "52.0.0",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "extra": {
      "appDescription": "Guided movement recording for research",
      "eas": {
        "projectId": "3db4ae90-2d4d-41f9-9689-f70f656ac581"
      }
    },
    "plugins": [
      "./plugins/with-local-calibration",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow GaitTrace to estimate an optional outdoor walking distance while a test is in progress. Coordinates are not stored or uploaded."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow GaitTrace to record motion for your walking research session."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GaitTrace to record front-camera video alongside motion sensors for a local research trial.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "owner": "frankielingishere"
  }
}
