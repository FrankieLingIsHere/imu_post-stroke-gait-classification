{
  "expo": {
    "name": "GaitTrace",
    "slug": "gait-steps",
    "version": "0.2.0",
    "icon": "./assets/branding/icon.png",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": {
      "url": "https://u.expo.dev/3db4ae90-2d4d-41f9-9689-f70f656ac581",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gaitsteps.app"
    },
    "android": {
      "package": "com.gaitsteps.app",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/branding/icon.png", "backgroundColor": "#176B62" }
    },
    "web": {
      "name": "GaitTrace",
      "shortName": "GaitTrace",
      "themeColor": "#176B62",
      "backgroundColor": "#F6F3EC"
    },
    "sdkVersion": "52.0.0",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "extra": {
      "appDescription": "Guided movement recording for research",
      "eas": {
        "projectId": "3db4ae90-2d4d-41f9-9689-f70f656ac581"
      }
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "Allow GaitTrace to record motion for your walking research session."
        }
      ]
    ],
    "owner": "frankielingishere"
  }
}
